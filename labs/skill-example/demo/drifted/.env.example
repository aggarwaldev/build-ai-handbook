# Pantry, an invented recipe site used to try the keeping-env-docs-in-step skill.
# Copy to .env and fill in the blanks. The README's "Environment variables" section describes
# every name here, in the same groups.

# server
PORT=8080
LOG_LEVEL=info

# database
DATABASE_URL=
DATABASE_POOL_SIZE=5

# search
SEARCH_API_KEY=
SEARCH_RESULTS_PER_PAGE=20
